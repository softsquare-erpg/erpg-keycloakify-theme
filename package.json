{
    "name": "erpg-keycloakify-theme",
    "version": "2.0.0",
    "description": "Theme for ERPG using Keycloakify. Provides a custom Keycloak theme with modern UI, Bootstrap 5 styling, and seamless integration for the ERPG platform.",
    "author": "Adsadawut h. <l3omb.io>",
    "repository": {
        "type": "git",
        "url": "git://github.com/softsquare-erpg/erpg-keycloakify-theme.git"
    },
    "publishConfig": {
        "registry": "https://maven.pkg.github.com/softsquare-erpg/erpg-keycloakify-theme"
    },
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc && vite build",
        "build-keycloak-theme": "npm run build && keycloakify build",
        "storybook": "storybook dev -p 6006",
        "format": "prettier . --write"
    },
    "license": "MIT",
    "keywords": [],
    "dependencies": {
        "bootstrap": "^5.3.6",
        "bootstrap-icons": "^1.13.1",
        "keycloakify": "^11.9.3",
        "react": "^19.1.1",
        "react-dom": "^19.1.1"
    },
    "devDependencies": {
        "@eslint/js": "^9.33.0",
        "@storybook/react": "^9.1.3",
        "@storybook/react-vite": "^9.1.3",
        "@types/bootstrap": "^5",
        "@types/node": "^24.3.0",
        "@types/react": "^19.1.10",
        "@types/react-dom": "^19.1.7",
        "@typescript-eslint/eslint-plugin": "^8.42.0",
        "@typescript-eslint/parser": "^8.42.0",
        "@vitejs/plugin-react": "^5.0.0",
        "eslint": "^9.33.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^5.2.0",
        "eslint-plugin-react-refresh": "^0.4.20",
        "eslint-plugin-storybook": "^0.11.1",
        "globals": "^16.3.0",
        "prettier": "3.3.1",
        "sass-embedded": "^1.92.0",
        "storybook": "^9.1.4",
        "typescript": "~5.8.3",
        "typescript-eslint": "^8.39.1",
        "vite": "^7.1.2"
    },
    "engines": {
        "node": "v20.19.4"
    },
    "packageManager": "yarn@4.5.1"
